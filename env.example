# Copia este archivo como ".env" y rellena con los datos de tu proyecto Supabase
# (Project Settings > API en el panel de Supabase).
#
# VITE_SUPABASE_URL es la "Project URL".
# VITE_SUPABASE_ANON_KEY es la "anon public" key — NUNCA la "service_role" key,
# esa segunda es secreta y no debe usarse en código que corre en el navegador.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# Inicio de sesión con Microsoft 365 (opcional). Si dejas estas dos vacías, el
# botón "Iniciar sesión con Microsoft" simplemente no aparece — todo lo demás
# sigue funcionando igual con nombre y contraseña.
# Sácalos de Azure Portal > Microsoft Entra ID > App registrations > tu app > Overview.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
